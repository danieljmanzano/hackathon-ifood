APP_NAME="Macro · Hackathon iFood API"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Modo e Banco de Dados (mock ou live)
IFOOD_MODE=mock
DATABASE_PATH=data/macro.sqlite3
TIMEZONE=America/Sao_Paulo

# iFood MCP (live OAuth 2.1 PKCE)
IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_REDIRECT_URI=http://localhost:4000
IFOOD_SCOPES=openid discovery:read

# Intenção contextual: OpenRouter com fallback para regras locais
INTENT_LLM_ENABLED=true
INTENT_LLM_TIMEOUT_SECONDS=18

# OpenRouter LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash


# Pipeline nutricional: openai (GPT, pago) ou openrouter (modelos gratuitos, usa OPENROUTER_API_KEY).
# Também escolhe ao subir: python -m app.run --llm openai|openrouter
NUTRITION_PROVIDER=openai
OPENAI_API_KEY=
NUTRITION_MODEL=gpt-5.4-mini
NUTRITION_OPENROUTER_MODEL=google/gemma-4-31b-it:free
NUTRITION_OPENROUTER_FALLBACK_MODELS=["google/gemma-4-26b-a4b-it:free","nvidia/nemotron-3.5-super-vl:free","openrouter/free"]
# Busca da tabela oficial na web pelo OpenRouter: cobrada por uso, mesmo com modelo gratuito
NUTRITION_OPENROUTER_WEB_SEARCH=false

# Pipeline de calorias (opcionais; valores padrão em app/core/config.py)
CALORIAS_ESTIMAR_SEMPRE=true
CALORIAS_BUSCAR_BASES=true
CALORIAS_BUSCA_WEB=true
CALORIAS_AMOSTRAS=1
CALORIAS_LIMIAR_CONFIANCA=0.55
# Logs do pipeline: off | resumo | detalhe (ou python -m app.run --log detalhe)
CALORIAS_LOG=resumo
