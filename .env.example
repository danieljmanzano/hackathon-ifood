# Execute a partir da raiz do repositório. Não coloque tokens no frontend.
MACRO_IFOOD_MODE=mock
MACRO_DATABASE_PATH=data/macro.sqlite3
MACRO_TIMEZONE=America/Sao_Paulo
MACRO_IFOOD_ENDPOINT=https://consumer-mcp.ifood.com.br/marketplace
# live habilita somente leitura. Use token de conta de teste autorizada.
MACRO_IFOOD_ACCESS_TOKEN=
MACRO_MCP_TIMEOUT_SECONDS=20
