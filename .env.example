APP_NAME="Macro · Hackathon iFood API"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Modo e Banco de Dados (mock ou live)
IFOOD_MODE=mock
DATABASE_PATH=data/macro.sqlite3
TIMEZONE=America/Sao_Paulo

# iFood MCP (live OAuth 2.1 PKCE)
IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_REDIRECT_URI=http://localhost:4000
IFOOD_SCOPES=openid discovery:read

# OpenRouter LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
