APP_NAME="Macro · Hackathon iFood API"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Modo e Banco de Dados (mock ou live)
IFOOD_MODE=mock
DATABASE_PATH=data/macro.sqlite3
TIMEZONE=America/Sao_Paulo

# iFood MCP (live OAuth 2.1 PKCE)
IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_REDIRECT_URI=http://localhost:4000
IFOOD_SCOPES=openid discovery:read

# Intenção contextual: OpenRouter com fallback para regras locais
INTENT_LLM_ENABLED=true
INTENT_LLM_TIMEOUT_SECONDS=18

# OpenRouter LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash


# Pipeline nutricional: openai (GPT, pago) ou openrouter (modelos gratuitos, usa OPENROUTER_API_KEY).
# Também escolhe ao subir: python -m app.run --llm openai|openrouter
NUTRITION_PROVIDER=openai
OPENAI_API_KEY=
NUTRITION_MODEL=gpt-5.4-mini
NUTRITION_OPENROUTER_MODEL=google/gemma-4-31b-it:free
NUTRITION_OPENROUTER_FALLBACK_MODELS=["google/gemma-4-26b-a4b-it:free","nvidia/nemotron-3.5-super-vl:free","openrouter/free"]
# Busca da tabela oficial na web pelo OpenRouter: cobrada por uso, mesmo com modelo gratuito
NUTRITION_OPENROUTER_WEB_SEARCH=false

# Pipeline de calorias (opcionais; valores padrão em app/core/config.py)
CALORIAS_ESTIMAR_SEMPRE=true
CALORIAS_BUSCAR_BASES=true
CALORIAS_BUSCA_WEB=true
CALORIAS_AMOSTRAS=1
CALORIAS_LIMIAR_CONFIANCA=0.55
# Logs do pipeline: off | resumo | detalhe (ou python -m app.run --log detalhe)
CALORIAS_LOG=resumo

# Logs de busca e recomendação: off, resumo ou detalhe
BUSCA_LOG=resumo
# Se o LLM de texto falhar, tenta o outro provedor (precisa da chave dele): true | false
LLM_FALLBACK=true

# Busca com laço de agente: sem resultado, um modelo replaneja (outras consultas) ou explica ao usuário
BUSCA_REPLANEJAR=true
BUSCA_MAX_REPLANEJAMENTOS=1
# Logs da busca só têm contagens (privacidade). true mostra consultas e respostas dos modelos (depuração)
BUSCA_LOG_CONTEUDO=false
# Quanto da conversa o agente de busca lê: últimas N mensagens (0 desliga), cortadas em M caracteres
BUSCA_HISTORICO_MENSAGENS=6
BUSCA_HISTORICO_MAX_CARACTERES=300
# No modo live o planejador de busca pode explorar o iFood com tools de LEITURA do MCP (categorias, restaurantes, cardápio)
BUSCA_MCP_FERRAMENTAS=true
BUSCA_MAX_PASSOS_PLANEJADOR=2
# Quanto o provedor principal de LLM pode demorar antes de a reserva (o outro provedor) assumir
LLM_FALLBACK_APOS_SEGUNDOS=20
# Prazo total da busca com o laço do agente (o frontend desiste aos 30 s)
BUSCA_PRAZO_TOTAL_SEGUNDOS=28
# Tempo máximo de cada pergunta ao planejador de busca
BUSCA_REPLANEJAR_TIMEOUT_SECONDS=10

# Catálogo real + reviews simuladas (identificadas na interface). Não libera checkout real.
LIVE_MOCK_REVIEWS=true
CATALOG_ENRICHMENT_ENABLED=true
CATALOG_PRODUCTS_PER_SEARCH=3
CATALOG_PRODUCTS_PER_DAY=20
CATALOG_CALLS_PER_PRODUCT=8
CATALOG_CALLS_PER_DAY=60
CATALOG_MAX_OUTPUT_TOKENS=1800
CATALOG_MAX_INPUT_CHARS=24000
CATALOG_RETRY_SECONDS=900
CATALOG_MAX_ATTEMPTS=2
